{
  "name": "@local/dsh-rimworld-defs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RimWorld Defs 查询面板：侧栏入口 + 搜索/详情/贴图",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "paths.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-session"]
    }
  }
}
